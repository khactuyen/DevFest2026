# Development: leave ALL Supabase values empty to use local accounts/JSON.
# Production: all three Supabase values and APP_ORIGIN are required.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never use a NEXT_PUBLIC_* name for the service role key.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical public origin, required behind a production reverse proxy.
APP_ORIGIN=
# OpenRouter: keep this file tracked, but put your real key in .env.local.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=google/gemini-4-carbon
OPENROUTER_LIGHT_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_VISION_MODEL=deepseek/deepseek-v4.1-flash
# Google AI Studio API key for Gemini Decision 1.
GEMINI_API_KEY=
# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Math Vision AI
# Register at /register, then grant author access through /admin/users.
# Bootstrap an administrator with npm run auth:bootstrap -- you@example.com.
# Local development also requires an account for saving, AI and authoring.
# Optional. Google OAuth Web client ID for exporting lesson knowledge checks.
# Enable Google Drive API and register the MathCos URL under Authorized JavaScript origins.
# For local use, open the app on localhost and register the matching origin and port.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=

# Optional. For teacher-approved knowledge check results, use a verified sender.
# Set APP_ORIGIN to the public MathCos URL so students can open result links.
RESEND_API_KEY=
LESSON_ASSESSMENT_FROM_EMAIL=
